---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SummaryCard from '../components/SummaryCard.astro';

const all = (await getCollection('summaries'))
  .filter((s) => !s.data.draft)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

// Every atomic note, across every source — this feeds the "Idea of the day"
// engagement hook (a daily-rotating spark).
const byId = new Map(all.map((s) => [s.id, s.data]));
const sparks = (await getCollection('notes'))
  .filter((n) => !n.data.draft)
  .map((n) => {
    const src = n.data.sources.map((id) => byId.get(id)).find(Boolean);
    return {
      text: n.data.claim,
      book: src?.title ?? 'Your own note',
      author: src?.author ?? '',
      id: n.id,
      accent: src?.accent ?? '#6b6b76',
    };
  });
---

<BaseLayout title="Distil — a library of distilled ideas">
  <section class="wrap hero">
    <h1>The ideas worth remembering,<br />distilled.</h1>
    <p>
      A second brain built one atomic note at a time — everything I've read,
      boiled down to single claims and wired together so the ideas argue with
      each other.
    </p>
  </section>

  {
    sparks.length > 0 && (
      <section class="wrap">
        <div class="panel" id="spark" style="display:none">
          <p class="panel-sub">✦ Idea of the day</p>
          <p
            class="oneline"
            id="spark-text"
            style="font-family:var(--font-serif);font-size:1.3rem;line-height:1.45;border-left:3px solid var(--accent);padding-left:16px;margin:0 0 12px"
          />
          <a class="chip" id="spark-link" href="/">—</a>
        </div>
        <script
          type="application/json"
          id="spark-data"
          set:html={JSON.stringify(sparks)}
        />
        <script is:inline>
          (function () {
            try {
              var data = JSON.parse(
                document.getElementById('spark-data').textContent,
              );
              if (!data.length) return;
              // Deterministic per-day pick so it rotates daily, not per reload.
              var day = Math.floor(Date.now() / 86400000);
              var pick = data[day % data.length];
              document.getElementById('spark-text').textContent = pick.text;
              var link = document.getElementById('spark-link');
              link.textContent =
                pick.book + (pick.author ? ' · ' + pick.author : '');
              link.href = '/notes/' + pick.id + '/';
              document.getElementById('spark').style.display = 'block';
            } catch (e) {}
          })();
        </script>
      </section>
    )
  }

  <section class="wrap">
    <div class="section-head">
      <h2>Library</h2>
      <span class="count">
        {all.length} {all.length === 1 ? 'source' : 'sources'}
      </span>
    </div>
    <div class="grid">
      {
        all.map((s) => (
          <SummaryCard
            id={s.id}
            title={s.data.title}
            author={s.data.author}
            oneLine={s.data.oneLine}
            cover={s.data.cover}
            accent={s.data.accent}
            readingTime={s.data.readingTime}
            rating={s.data.rating}
            topics={s.data.topics}
          />
        ))
      }
    </div>
  </section>
</BaseLayout>
